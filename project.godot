; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Package Bot Factory"
config/description="A mobile factory game where you sort packages with suction tubes."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.png"

[autoload]

SignalBus="*res://scripts/core/SignalBus.gd"
GameManager="*res://scripts/core/GameManager.gd"
LevelManager="*res://scripts/core/LevelManager.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
Constants="*res://scripts/core/Constants.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/test_width=720
window/size/test_height=1280

[dotnet]

project/assembly_name="Package Bot Factory"

[input]

ui_touch={
"deadzone": 0.5,
"events": [Object(InputEventScreenTouch,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"index":0,"position":Vector2(0, 0),"canceled":false,"pressed":false,"double_tap":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
quality/driver/driver_name="GLES3"
